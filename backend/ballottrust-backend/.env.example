# ---- Database (REQUIRED) ----
# Consumed by prisma/schema.prisma -> datasource db { url = env("DATABASE_URL") }
# Local dev uses the Docker Postgres on port 5433 (see README / docker run command).
DATABASE_URL="postgresql://ballottrust:ballottrust@localhost:5433/ballottrust?schema=public"

# ---- Auth (REQUIRED) ----
# Signing key for access/refresh JWTs. Use a long random value in any
# non-local environment. NEVER commit a real secret.
JWT_SECRET="dev-only-jwt-secret-change-in-production"

# ---- App (OPTIONAL - defaults shown) ----
# Backend listen port. Default: 3000
PORT=3000
# Standard Nest environment flag. Default: unset (development)
NODE_ENV=development
# Absolute base URL of the frontend, used to build links inside emails.
FRONTEND_URL="http://localhost:5173"
# Comma-separated CORS allowlist.
# Default when unset: "http://localhost:3000,http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ---- First-admin bootstrap (OPTIONAL; leave unset in normal operation) ----
# POST /api/v1/auth/bootstrap-admin creates the first SUPER_ADMIN so a fresh
# deployment has someone who can sign in. It answers 404 unless
# BOOTSTRAP_ADMIN_TOKEN is set, refuses once any SUPER_ADMIN exists, and
# requires the caller to present the token. Set these three only while
# bootstrapping, then remove them.
# BOOTSTRAP_ADMIN_TOKEN=<long random string>
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=<strong password>

# ---- Google OAuth (REQUIRED to boot; placeholders are fine) ----
# The passport-google-oauth20 strategy is registered at startup and reads
# these eagerly, so they must be present. The values below are dummies:
# the /auth/google flow will not work until you supply real credentials
# from a Google Cloud OAuth client.
GOOGLE_CLIENT_ID="dev-google-client-id"
GOOGLE_CLIENT_SECRET="dev-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# ---- Mail (REQUIRED; local SMTP catcher) ----
# Read via ConfigService in the MailerModule. Local dev points at Mailpit
# (SMTP 1025, web UI 8025) so no real mail is ever sent.
MAIL_HOST="localhost"
MAIL_PORT="1025"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="BallotTrust <no-reply@ballottrust.local>"
