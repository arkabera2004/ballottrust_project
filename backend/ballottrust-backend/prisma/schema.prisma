generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                     @id @default(uuid())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  fullName                      String
  email                         String                     @unique
  password                      String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  createdAt                     DateTime                   @default(now())
  role                          Role                       @default(VOTER)
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  department                    String?
  profilePhoto                  String?
  registrationNumber            String?
  status                        UserStatus                 @default(PENDING)
  studentIdCard                 String?
  updatedAt                     DateTime                   @updatedAt
  emailVerified                 Boolean                    @default(false)
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  failedLoginAttempts           Int                        @default(0)
  lastLogin                     DateTime?
  lockedUntil                   DateTime?
  phoneNumber                   String?
  profileCompleted              Boolean                    @default(false)
  providerId                    String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  address                       String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  avatarUrl                     String?
  bio                           String?
  city                          String?
  country                       String?
  course                        String?
  dateOfBirth                   DateTime?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  deletedAt                     DateTime?
  gender                        String?
  lastPasswordChange            DateTime?
  mfaEnabled                    Boolean                    @default(false)
  mfaSecret                     String?
  postalCode                    String?
  semester                      Int?
  state                         String?
  year                          Int?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  provider                      AuthProvider               @default(LOCAL)
  emailVerificationOtp          String?
  emailVerificationOtpExpiresAt DateTime?
  passwordResetToken            String?
  passwordResetTokenExpiresAt   DateTime?
  avatar                        String?
  googleLinked                  Boolean                    @default(false)
  auditLogs                     AuditLog[]
  candidates                    Candidate[]                @relation("CandidateUser")
  verifiedCandidates            Candidate[]                @relation("CandidateVerifiedBy")
  approvedCandidates            Candidate[]                @relation("CandidateApprovedBy")
  rejectedCandidates            Candidate[]                @relation("CandidateRejectedBy")
  disqualifiedCandidates        Candidate[]                @relation("CandidateDisqualifiedBy")
  verifiedCandidateDocuments    CandidateDocument[]        @relation("CandidateDocumentVerifiedBy")
  rejectedCandidateDocuments    CandidateDocument[]        @relation("CandidateDocumentRejectedBy")
  approvedElections             Election[]                 @relation("ElectionApprover")
  createdElections              Election[]                 @relation("ElectionCreator")
  publishedElections            Election[]                 @relation("ElectionPublisher")
  ballotFinalizedElections      Election[]                 @relation("ElectionBallotFinalizer")
  reports                       ElectionReport[]
  notifications                 Notification[]
  refreshTokens                 RefreshToken[]
  sessions                      Session[]
  voterCredentials              VoterCredential[]
  createdEligibilityRuleSets    EligibilityRuleSet[]
  eligibilitySnapshots          VoterEligibilitySnapshot[]
  voterRegistrations            VoterRegistration[]        @relation("VoterRegistrationUser")
  verifiedVoterRegistrations    VoterRegistration[]        @relation("VoterRegistrationVerifiedBy")
  approvedVoterRegistrations    VoterRegistration[]        @relation("VoterRegistrationApprovedBy")
  rejectedVoterRegistrations    VoterRegistration[]        @relation("VoterRegistrationRejectedBy")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([provider])
  @@index([department])
  @@index([registrationNumber])
  @@index([emailVerified])
  @@index([failedLoginAttempts])
}

model Election {
  id                   String                     @id @default(uuid())
  title                String
  description          String?
  startDate            DateTime
  endDate              DateTime
  status               ElectionStatus             @default(DRAFT)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  closedAt             DateTime?
  createdById          String?
  deletedAt            DateTime?
  publishedAt          DateTime?
  allowRevote          Boolean                    @default(false)
  approvedById         String?
  auditEnabled         Boolean                    @default(true)
  autoArchive          Boolean                    @default(false)
  autoPublish          Boolean                    @default(false)
  banner               String?
  blockchainEnabled    Boolean                    @default(true)
  campaignEnd          DateTime?
  campaignStart        DateTime?
  candidateLimit       Int                        @default(0)
  electionCode         String                     @unique
  electionType         ElectionType
  ballotOrderMethod    BallotOrderMethod?
  ballotFinalizedAt    DateTime?
  ballotFinalizedById  String?
  logo                 String?
  maximumVotes         Int                        @default(1)
  nominationEnd        DateTime?
  nominationStart      DateTime?
  publishedById        String?
  registrationEnd      DateTime?
  registrationStart    DateTime?
  resultDate           DateTime?
  resultVisibility     ResultVisibility           @default(AFTER_CLOSURE)
  approvedAt           DateTime?
  candidates           Candidate[]
  dashboardMetrics     DashboardMetric[]
  approvedBy           User?                      @relation("ElectionApprover", fields: [approvedById], references: [id])
  createdBy            User?                      @relation("ElectionCreator", fields: [createdById], references: [id])
  publishedBy          User?                      @relation("ElectionPublisher", fields: [publishedById], references: [id])
  ballotFinalizedBy    User?                      @relation("ElectionBallotFinalizer", fields: [ballotFinalizedById], references: [id])
  reports              ElectionReport[]
  voterRegistrations   VoterRegistration[]
  votes                Vote[]
  voterCredentials     VoterCredential[]
  eligibilityRuleSets  EligibilityRuleSet[]
  eligibilitySnapshots VoterEligibilitySnapshot[]

  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([createdById])
  @@index([electionCode])
  @@index([ballotFinalizedById])
}

model Party {
  id           String    @id @default(uuid())
  name         String
  shortName    String?
  abbreviation String?
  symbol       String?
  logo         String?
  color        String?
  description  String?
  website      String?
  email        String?
  phone        String?
  foundedOn    DateTime?
  headquarters String?

  status PartyStatus @default(ACTIVE)

  candidates Candidate[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([name])
  @@index([status])
}

model Candidate {
  id String @id @default(uuid())

  // ==========================================
  // Core Relations
  // ==========================================

  electionId String
  userId     String

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  user User @relation("CandidateUser", fields: [userId], references: [id])

  // ==========================================
  // Candidate Type / Party
  // ==========================================

  candidateType CandidateType @default(INDEPENDENT)

  partyId String?

  party Party? @relation(fields: [partyId], references: [id])

  // ==========================================
  // Election Information
  // ==========================================

  candidateNumber Int?

  ballotOrder Int?

  position String?

  // ==========================================
  // Candidate Profile
  // ==========================================

  biography       String?
  campaignSlogan  String?
  campaignWebsite String?

  // ==========================================
  // Manifesto / Campaign Information
  // ==========================================

  manifesto    String?
  agenda       String?
  achievements String?

  // ==========================================
  // Nomination Information
  // ==========================================

  nominationStatement String?

  // ==========================================
  // Candidate Documents
  // ==========================================

  photoUrl    String?
  documentUrl String?

  // ==========================================
  // Workflow
  // ==========================================

  status CandidateStatus @default(DRAFT)

  submittedAt DateTime?

  // ==========================================
  // Verification
  // ==========================================

  verifiedById String?
  verifiedAt   DateTime?

  verifiedBy User? @relation("CandidateVerifiedBy", fields: [verifiedById], references: [id])

  // ==========================================
  // Approval
  // ==========================================

  approvedById String?
  approvedAt   DateTime?

  approvedBy User? @relation("CandidateApprovedBy", fields: [approvedById], references: [id])

  // ==========================================
  // Rejection
  // ==========================================

  rejectedById    String?
  rejectionReason String?
  rejectedAt      DateTime?

  rejectedBy User? @relation("CandidateRejectedBy", fields: [rejectedById], references: [id])

  // ==========================================
  // Withdrawal / Disqualification
  // ==========================================

  withdrawnAt DateTime?

  withdrawalReason String?

  disqualifiedById String?
  disqualifiedAt   DateTime?

  disqualificationReason String?

  disqualifiedBy User? @relation("CandidateDisqualifiedBy", fields: [disqualifiedById], references: [id])

  // ==========================================
  // Relations
  // ==========================================

  documents CandidateDocument[]

  votes Vote[]

  // ==========================================
  // System
  // ==========================================

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // ==========================================
  // Constraints
  // ==========================================

  @@unique([userId, electionId])
  @@unique([electionId, candidateNumber])
  @@unique([electionId, ballotOrder])
  @@index([status])
  @@index([candidateType])
  @@index([partyId])
  @@index([electionId])
  @@index([userId])
}

model CandidateDocument {
  id String @id @default(uuid())

  // ==========================================
  // Candidate Relation
  // ==========================================

  candidateId String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // ==========================================
  // Document Information
  // ==========================================

  documentType CandidateDocumentType

  originalFileName String

  fileUrl String

  mimeType String

  fileSize Int

  // ==========================================
  // Verification Workflow
  // ==========================================

  status CandidateDocumentStatus @default(PENDING)

  verifiedById String?
  verifiedAt   DateTime?

  verifiedBy User? @relation("CandidateDocumentVerifiedBy", fields: [verifiedById], references: [id])

  // ==========================================
  // Rejection
  // ==========================================

  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?

  rejectedBy User? @relation("CandidateDocumentRejectedBy", fields: [rejectedById], references: [id])

  // ==========================================
  // Replacement Tracking
  // ==========================================

  replacedAt DateTime?

  // ==========================================
  // System
  // ==========================================

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // ==========================================
  // Indexes
  // ==========================================

  @@index([candidateId])
  @@index([documentType])
  @@index([status])
  @@index([verifiedById])
  @@index([rejectedById])
  @@index([candidateId, status])
}

/// Anonymous vote ledger. Deliberately has NO foreign key to User and NO
/// voter-identifying column — this is the enforced structural boundary
/// between voter identity and cast ballots. See VoterCredential below and
/// /docs/privacy-architecture.md for the full design.
model Vote {
  id                    String                 @id @default(uuid())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  /// One-time, non-reversible anonymous voting credential consumed at cast
  /// time. Never derived reversibly from the voter's userId.
  anonymousToken        String                 @unique
  candidateId           String
  electionId            String
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  createdAt             DateTime               @default(now())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  hash                  String?
  previousHash          String?
  encryptedVote         String?
  signature             String?
  blockchainTransaction BlockchainTransaction?
  candidate             Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  election              Election               @relation(fields: [electionId], references: [id], onDelete: Cascade)
  receipt               VoteReceipt?

  @@index([candidateId])
  @@index([electionId])
  @@index([hash])
}

/// Eligibility/credential store — structurally separate from the Vote
/// ledger above. Records ONLY that a voter has (or hasn't) consumed their
/// single voting credential for an election; never records which candidate
/// they chose. No query can join this table to Vote to reconstruct a
/// voter -> candidate mapping.
model VoterCredential {
  id         String    @id @default(uuid())
  userId     String
  electionId String
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  hasVoted   Boolean   @default(false)
  issuedAt   DateTime  @default(now())
  usedAt     DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  election   Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([userId, electionId])
  @@index([electionId])
}

/// Sec4: versioned voter-eligibility rule tree for an election. Editing
/// rules never mutates a row in place — it creates a new version and
/// deactivates the previous one, so every past evaluation stays
/// explainable against the exact rule set that produced it.
model EligibilityRuleSet {
  id          String                     @id @default(uuid())
  electionId  String
  version     Int
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  isActive    Boolean                    @default(true)
  description String?
  /// AND/OR/NOT/CONDITION tree — see eligibility/types.ts for the shape.
  rule        Json
  createdById String
  createdAt   DateTime                   @default(now())
  election    Election                   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  createdBy   User                       @relation(fields: [createdById], references: [id])
  snapshots   VoterEligibilitySnapshot[]

  @@unique([electionId, version])
  @@index([electionId, isActive])
}

/// Sec4: persisted result of one eligibility evaluation. Doubles as the
/// explainability/audit record — every check (real-time at vote-cast time
/// or an admin's bulk preview) writes one row here, so "why was voter X
/// eligible/ineligible for election Y" is always answerable after the
/// fact without re-deriving it from mutable state.
model VoterEligibilitySnapshot {
  id          String              @id @default(uuid())
  electionId  String
  userId      String
  /// Null when no EligibilityRuleSet existed yet — evaluated against the
  /// default rule (role = VOTER AND status = APPROVED).
  ruleSetId   String?
  eligible    Boolean
  explanation Json
  evaluatedAt DateTime            @default(now())
  election    Election            @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleSet     EligibilityRuleSet? @relation(fields: [ruleSetId], references: [id])

  @@index([electionId, userId])
  @@index([ruleSetId])
}

model RefreshToken {
  id              String    @id @default(uuid())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  userId          String
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  expiresAt       DateTime
  revoked         Boolean   @default(false)
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  createdAt       DateTime  @default(now())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  deviceName      String?
  ipAddress       String?
  lastUsedAt      DateTime?
  tokenHash       String    @unique
  userAgent       String?
  tokenVersion    Int       @default(1)
  browser         String?
  city            String?
  country         String?
  operatingSystem String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revoked])
  @@index([tokenVersion])
}

model Session {
  id              String    @id @default(uuid())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  userId          String
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  device          String?
  ipAddress       String?
  userAgent       String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  createdAt       DateTime  @default(now())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  expiresAt       DateTime
  revoked         Boolean   @default(false)
  browser         String?
  city            String?
  country         String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  lastActive      DateTime?
  operatingSystem String?
  trusted         Boolean   @default(false)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revoked])
  @@index([expiresAt])
  @@index([trusted])
}

model Notification {
  id          String           @id @default(uuid())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  userId      String
  title       String
  message     String
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  actionLabel String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  deletedAt   DateTime?
  isArchived  Boolean          @default(false)
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  link        String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  readAt      DateTime?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  type        NotificationType @default(INFO)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id              String        @id @default(uuid())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  userId          String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  action          String
  module          String
  description     String?
  ipAddress       String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  createdAt       DateTime      @default(now())
  browser         String?
  city            String?
  country         String?
  entityId        String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  entityType      String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  metadata        Json?
  operatingSystem String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  severity        AuditSeverity @default(LOW)
  user            User?         @relation(fields: [userId], references: [id])
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  /// Tamper-evident hash chain: hash = SHA256(previousHash + actor + action
  /// + module + entityType + entityId + result + createdAt). Any past
  /// record altered breaks every subsequent hash, making tampering
  /// detectable via AuditService.verifyChain().
  result          String?
  hash            String?
  previousHash    String?

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([severity])
  @@index([createdAt])
  @@index([hash])
}

model BlockchainTransaction {
  id               String           @id @default(uuid())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  voteId           String           @unique
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  transactionHash  String           @unique
  network          String?          @default("Polygon Amoy")
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  createdAt        DateTime         @default(now())
  blockHash        String?
  chainId          String?
  confirmations    Int              @default(0)
  contractAddress  String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  errorMessage     String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  explorerUrl      String?
  gasPrice         String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  gasUsed          String?
  retryCount       Int              @default(0)
  transactionFee   String?
  updatedAt        DateTime         @updatedAt
  verificationTime DateTime?
  verified         Boolean          @default(false)
  blockNumber      BigInt?
  status           BlockchainStatus @default(PENDING)
  vote             Vote             @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([network])
  @@index([createdAt])
}

model VoteReceipt {
  id               String    @id @default(uuid())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  voteId           String    @unique
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  receiptNumber    String    @unique
  verificationCode String    @unique
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  createdAt        DateTime  @default(now())
  downloaded       Boolean   @default(false)
  downloadedAt     DateTime?
  downloadedCount  Int       @default(0)
  pdfUrl           String?
  qrCodeUrl        String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  verificationHash String?
  vote             Vote      @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@index([receiptNumber])
  @@index([verificationCode])
}

model ElectionReport {
  id            String   @id @default(uuid())
  electionId    String
  reportName    String
  reportType    String
  generatedById String?
  fileUrl       String?
  fileSize      String?
  format        String?
  status        String   @default("GENERATED")
  createdAt     DateTime @default(now())
  election      Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  generatedBy   User?    @relation(fields: [generatedById], references: [id])

  @@index([electionId])
  @@index([generatedById])
}

model DashboardMetric {
  id           String    @id @default(uuid())
  metricName   String
  metricValue  Float
  category     String?
  calculatedAt DateTime  @default(now())
  electionId   String?
  election     Election? @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([metricName])
  @@index([calculatedAt])
}

enum Role {
  SUPER_ADMIN
  ELECTION_COMMISSIONER
  VERIFICATION_OFFICER
  RETURNING_OFFICER
  AUDITOR
  CANDIDATE
  VOTER
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ElectionType {
  STUDENT_COUNCIL
  CLUB
  UNIVERSITY
  CORPORATE
  GOVERNMENT
  CUSTOM
}

enum ElectionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  ACTIVE
  VOTING_CLOSED
  RESULT_PUBLISHED
  ARCHIVED
}

enum ResultVisibility {
  IMMEDIATE
  AFTER_CLOSURE
  MANUAL
}

enum CandidateStatus {
  DRAFT
  PENDING
  VERIFIED
  APPROVED
  REJECTED
  WITHDRAWN
  DISQUALIFIED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SECURITY
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlockchainStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum CandidateType {
  INDEPENDENT
  PARTY
}

enum PartyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BallotOrderMethod {
  CANDIDATE_NUMBER
  ALPHABETICAL
  RANDOM
  MANUAL
}

enum CandidateDocumentType {
  IDENTITY_PROOF
  STUDENT_ID
  ELIGIBILITY_PROOF
  NOMINATION_FORM
  SUPPORTING_DOCUMENT
  OTHER
}

enum CandidateDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Status of a voter's registration for one specific election.
/// Verification and approval are distinct steps: a Verification Officer
/// confirms the supporting identity details, an Election Commissioner
/// then admits the voter to the roll.
enum VoterRegistrationStatus {
  PENDING
  VERIFIED
  APPROVED
  REJECTED
}

/// How the registration entered the system.
enum VoterRegistrationSource {
  SELF
  IMPORT
  ADMIN
}

/// A voter's enrolment on the roll for one election.
///
/// Deliberately *not* a separate identity table: a voter is a User with
/// role VOTER, which is what the eligibility engine evaluates against and
/// what VoterCredential keys off. This model captures the per-election
/// registration workflow only.
model VoterRegistration {
  id         String                  @id @default(uuid())
  userId     String
  electionId String
  status     VoterRegistrationStatus @default(PENDING)
  source     VoterRegistrationSource @default(SELF)

  registeredAt DateTime @default(now())

  verifiedById String?
  verifiedAt   DateTime?

  approvedById String?
  approvedAt   DateTime?

  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user       User     @relation("VoterRegistrationUser", fields: [userId], references: [id], onDelete: Cascade)
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation("VoterRegistrationVerifiedBy", fields: [verifiedById], references: [id])
  approvedBy User?    @relation("VoterRegistrationApprovedBy", fields: [approvedById], references: [id])
  rejectedBy User?    @relation("VoterRegistrationRejectedBy", fields: [rejectedById], references: [id])

  /// Business rule: one registration per voter per election.
  @@unique([userId, electionId])
  @@index([electionId, status])
  @@index([userId])
  @@index([status])
}
