generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  SUPER_ADMIN
  ELECTION_COMMISSIONER
  AUDITOR
  CANDIDATE
  VOTER
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

//////////////////////////////////////////////////////
// ELECTION ENUMS
//////////////////////////////////////////////////////

enum ElectionType {
  STUDENT_COUNCIL
  CLUB
  UNIVERSITY
  CORPORATE
  GOVERNMENT
  CUSTOM
}

enum ElectionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  ACTIVE
  VOTING_CLOSED
  RESULT_PUBLISHED
  ARCHIVED
}

enum ResultVisibility {
  IMMEDIATE
  AFTER_CLOSURE
  MANUAL
}

//////////////////////////////////////////////////////
// CANDIDATE
//////////////////////////////////////////////////////

enum CandidateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SECURITY
}

//////////////////////////////////////////////////////
// AUDIT
//////////////////////////////////////////////////////

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

//////////////////////////////////////////////////////
// BLOCKCHAIN
//////////////////////////////////////////////////////

enum BlockchainStatus {
  PENDING
  CONFIRMED
  FAILED
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @default(uuid())

  //////////////////////////////////////////////////////
  // BASIC
  //////////////////////////////////////////////////////

  fullName String

  email String @unique

  password String?

  role Role @default(VOTER)

  status UserStatus @default(PENDING)

  //////////////////////////////////////////////////////
  // PROFILE
  //////////////////////////////////////////////////////

  avatarUrl String?

  profilePhoto String?

  bio String?

  phoneNumber String?

  dateOfBirth DateTime?

  gender String?

  //////////////////////////////////////////////////////
  // ACADEMIC
  //////////////////////////////////////////////////////

  department String?

  course String?

  year Int?

  semester Int?

  registrationNumber String?

  studentIdCard String?

  //////////////////////////////////////////////////////
  // ADDRESS
  //////////////////////////////////////////////////////

  address String?

  city String?

  state String?

  country String?

  postalCode String?

  //////////////////////////////////////////////////////
  // AUTHENTICATION
  //////////////////////////////////////////////////////

  provider AuthProvider @default(LOCAL)

  providerId String?

  googleLinked Boolean @default(false)

  avatar String?

  emailVerified Boolean @default(false)

  profileCompleted Boolean @default(false)

  lastLogin DateTime?

  lastPasswordChange DateTime?

  //////////////////////////////////////////////////////
  // SECURITY
  //////////////////////////////////////////////////////

  failedLoginAttempts Int @default(0)

  lockedUntil DateTime?

  mfaEnabled Boolean @default(false)

  mfaSecret String?

  //////////////////////////////////////////////////////
  // SOFT DELETE
  //////////////////////////////////////////////////////

  deletedAt DateTime?

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  emailVerificationOtp String?

  emailVerificationOtpExpiresAt DateTime?

  passwordResetToken String?

  passwordResetTokenExpiresAt DateTime?

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  votes Vote[]

  reports ElectionReport[]

  refreshTokens RefreshToken[]

  sessions Session[]

  notifications Notification[]

  auditLogs AuditLog[]

  createdElections Election[] @relation("ElectionCreator")

  approvedElections Election[] @relation("ElectionApprover")

  publishedElections Election[] @relation("ElectionPublisher")

  candidateProfile Candidate? @relation("CandidateUser")

  reviewedCandidates Candidate[] @relation("CandidateReviewer")

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([provider])
  @@index([department])
  @@index([registrationNumber])
  @@index([emailVerified])
  @@index([failedLoginAttempts])
}

//////////////////////////////////////////////////////
// ELECTION
//////////////////////////////////////////////////////

model Election {

  id                 String             @id @default(uuid())

  // ======================================================
  // Basic Information
  // ======================================================

  title              String
  electionCode       String             @unique
  description        String?

  electionType       ElectionType

  status             ElectionStatus     @default(DRAFT)

  // ======================================================
  // Timeline
  // ======================================================

  registrationStart  DateTime?
  registrationEnd    DateTime?

  nominationStart    DateTime?
  nominationEnd      DateTime?

  campaignStart      DateTime?
  campaignEnd        DateTime?

  startDate          DateTime
  endDate            DateTime

  resultDate         DateTime?

  publishedAt        DateTime?
  closedAt           DateTime?
  deletedAt          DateTime?

  // ======================================================
  // Election Configuration
  // ======================================================

  candidateLimit     Int                @default(0)

  maximumVotes       Int                @default(1)

  allowRevote        Boolean            @default(false)

  blockchainEnabled  Boolean            @default(true)

  auditEnabled       Boolean            @default(true)

  autoPublish        Boolean            @default(false)

  autoArchive        Boolean            @default(false)

  resultVisibility   ResultVisibility   @default(AFTER_CLOSURE)

  // ======================================================
  // Branding
  // ======================================================

  banner             String?

  logo               String?

  // ======================================================
  // Ownership
  // ======================================================

  createdById        String?

  createdBy          User? @relation("ElectionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  approvedById       String?

  approvedBy User? @relation("ElectionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  publishedById String?

  publishedBy User? @relation("ElectionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  // ======================================================
  // Relations
  // ======================================================

  candidates         Candidate[]

  votes              Vote[]

  reports            ElectionReport[]

  dashboardMetrics   DashboardMetric[]

  // ======================================================
  // Audit
  // ======================================================

  createdAt          DateTime           @default(now())

  updatedAt          DateTime           @updatedAt

  // ======================================================
  // Indexes
  // ======================================================

  @@index([status])

  @@index([startDate])

  @@index([endDate])

  @@index([createdById])

  @@index([electionCode])

}

//////////////////////////////////////////////////////
// CANDIDATE
//////////////////////////////////////////////////////

model Candidate {
  id String @id @default(uuid())

  userId String? @unique

  user User? @relation("CandidateUser", fields: [userId], references: [id], onDelete: SetNull)

  name String

  email String?

  registrationNumber String?

  department String?

  position String?

  bio String?

  manifesto String?

  agenda String?

  achievements String?

  photoUrl String?

  documentUrl String?

  status CandidateStatus @default(DRAFT)

  reviewedById String?

  reviewedBy User? @relation("CandidateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?

  rejectionReason String?

  electionId String

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  votes Vote[]

  @@index([status])
  @@index([department])
  @@index([position])
  @@index([electionId])
}

//////////////////////////////////////////////////////
// VOTE
//////////////////////////////////////////////////////

model Vote {
  id String @id @default(uuid())

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  voterId String

  candidateId String

  electionId String

  //////////////////////////////////////////////////////
  // SECURITY
  //////////////////////////////////////////////////////

  hash String?

  previousHash String?

  encryptedVote String?

  signature String?

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  voter User @relation(fields: [voterId], references: [id], onDelete: Cascade)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  receipt VoteReceipt?

  blockchainTransaction BlockchainTransaction?

  @@unique([voterId, electionId])
  @@index([voterId])
  @@index([candidateId])
  @@index([electionId])
  @@index([hash])
}

//////////////////////////////////////////////////////
// REFRESH TOKEN
//////////////////////////////////////////////////////

model RefreshToken {
  id String @id @default(uuid())

  tokenHash String @unique

  tokenVersion Int @default(1)

  //////////////////////////////////////////////////////
  // USER
  //////////////////////////////////////////////////////

  userId String

  //////////////////////////////////////////////////////
  // DEVICE
  //////////////////////////////////////////////////////

  deviceName String?

  browser String?

  operatingSystem String?

  ipAddress String?

  userAgent String?

  country String?

  city String?

  //////////////////////////////////////////////////////
  // STATUS
  //////////////////////////////////////////////////////

  expiresAt DateTime

  lastUsedAt DateTime?

  revoked Boolean @default(false)

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  //////////////////////////////////////////////////////
  // RELATION
  //////////////////////////////////////////////////////

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([userId])
  @@index([expiresAt])
  @@index([revoked])
  @@index([tokenVersion])
}

//////////////////////////////////////////////////////
// SESSION
//////////////////////////////////////////////////////

model Session {
  id String @id @default(uuid())

  //////////////////////////////////////////////////////
  // USER
  //////////////////////////////////////////////////////

  userId String

  //////////////////////////////////////////////////////
  // DEVICE
  //////////////////////////////////////////////////////

  device String?

  browser String?

  operatingSystem String?

  ipAddress String?

  country String?

  city String?

  userAgent String?

  trusted Boolean @default(false)

  //////////////////////////////////////////////////////
  // ACTIVITY
  //////////////////////////////////////////////////////

  lastActive DateTime?

  //////////////////////////////////////////////////////
  // STATUS
  //////////////////////////////////////////////////////

  expiresAt DateTime

  revoked Boolean @default(false)

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  //////////////////////////////////////////////////////
  // RELATION
  //////////////////////////////////////////////////////

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([userId])
  @@index([revoked])
  @@index([expiresAt])
  @@index([trusted])
}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

model Notification {
  id String @id @default(uuid())

  //////////////////////////////////////////////////////
  // USER
  //////////////////////////////////////////////////////

  userId String

  //////////////////////////////////////////////////////
  // TYPE
  //////////////////////////////////////////////////////

  type NotificationType @default(INFO)

  title String

  message String

  //////////////////////////////////////////////////////
  // ACTION
  //////////////////////////////////////////////////////

  link String?

  actionLabel String?

  //////////////////////////////////////////////////////
  // STATUS
  //////////////////////////////////////////////////////

  isRead Boolean @default(false)

  isArchived Boolean @default(false)

  //////////////////////////////////////////////////////
  // SOFT DELETE
  //////////////////////////////////////////////////////

  deletedAt DateTime?

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  readAt DateTime?

  createdAt DateTime @default(now())

  //////////////////////////////////////////////////////
  // RELATION
  //////////////////////////////////////////////////////

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////////

model AuditLog {
  id String @id @default(uuid())

  //////////////////////////////////////////////////////
  // USER
  //////////////////////////////////////////////////////

  userId String?

  //////////////////////////////////////////////////////
  // ACTION
  //////////////////////////////////////////////////////

  action String

  module String

  description String?

  //////////////////////////////////////////////////////
  // ENTITY
  //////////////////////////////////////////////////////

  entityType String?

  entityId String?

  //////////////////////////////////////////////////////
  // SECURITY
  //////////////////////////////////////////////////////

  severity AuditSeverity @default(LOW)

  ipAddress String?

  browser String?

  operatingSystem String?

  country String?

  city String?

  //////////////////////////////////////////////////////
  // EXTRA DATA
  //////////////////////////////////////////////////////

  metadata Json?

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  //////////////////////////////////////////////////////
  // RELATION
  //////////////////////////////////////////////////////

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([severity])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// BLOCKCHAIN TRANSACTION
//////////////////////////////////////////////////////

model BlockchainTransaction {
  id String @id @default(uuid())

  //////////////////////////////////////////////////////
  // RELATION
  //////////////////////////////////////////////////////

  voteId String @unique

  //////////////////////////////////////////////////////
  // BLOCKCHAIN
  //////////////////////////////////////////////////////

  transactionHash String @unique

  blockHash String?

  blockNumber BigInt?

  network String? @default("Polygon Amoy")

  contractAddress String?

  chainId String?

  //////////////////////////////////////////////////////
  // GAS
  //////////////////////////////////////////////////////

  gasUsed String?

  gasPrice String?

  transactionFee String?

  //////////////////////////////////////////////////////
  // VERIFICATION
  //////////////////////////////////////////////////////

  explorerUrl String?

  confirmations Int @default(0)

  status BlockchainStatus @default(PENDING)

  verified Boolean @default(false)

  verificationTime DateTime?

  //////////////////////////////////////////////////////
  // FAILURE
  //////////////////////////////////////////////////////

  errorMessage String?

  retryCount Int @default(0)

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////////
  // RELATION
  //////////////////////////////////////////////////////

  vote Vote @relation(fields: [voteId], references: [id], onDelete: Cascade)

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([status])
  @@index([network])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// VOTE RECEIPT
//////////////////////////////////////////////////////

model VoteReceipt {
  id String @id @default(uuid())

  //////////////////////////////////////////////////////
  // RELATION
  //////////////////////////////////////////////////////

  voteId String @unique

  //////////////////////////////////////////////////////
  // RECEIPT
  //////////////////////////////////////////////////////

  receiptNumber String @unique

  verificationCode String @unique

  qrCodeUrl String?

  pdfUrl String?

  //////////////////////////////////////////////////////
  // SECURITY
  //////////////////////////////////////////////////////

  verificationHash String?

  downloaded Boolean @default(false)

  downloadedCount Int @default(0)

  downloadedAt DateTime?

  //////////////////////////////////////////////////////
  // TIMESTAMPS
  //////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  //////////////////////////////////////////////////////
  // RELATION
  //////////////////////////////////////////////////////

  vote Vote @relation(fields: [voteId], references: [id], onDelete: Cascade)

  //////////////////////////////////////////////////////
  // INDEXES
  //////////////////////////////////////////////////////

  @@index([receiptNumber])
  @@index([verificationCode])
}

//////////////////////////////////////////////////////
// ELECTION REPORT
//////////////////////////////////////////////////////

model ElectionReport {
  id String @id @default(uuid())

  electionId String

  reportName String

  reportType String

  generatedById String?

  generatedBy User? @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  fileUrl String?

  fileSize String?

  format String? // PDF / Excel / CSV

  status String @default("GENERATED")

  createdAt DateTime @default(now())

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId])
  @@index([generatedById])
}

//////////////////////////////////////////////////////
// DASHBOARD METRICS
//////////////////////////////////////////////////////

model DashboardMetric {
  id String @id @default(uuid())

  metricName String

  metricValue Float

  category String?

  calculatedAt DateTime @default(now())

  electionId String?

  election Election? @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([metricName])
  @@index([calculatedAt])
}
