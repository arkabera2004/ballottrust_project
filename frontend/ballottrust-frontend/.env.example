# ---- API base (OPTIONAL - default shown in src/config/env.ts) ----
# Leave as the relative path "/api/v1" so browser requests stay same-origin
# and the Vite dev proxy forwards them to the backend. Only set an absolute
# URL if you are NOT using the dev proxy.
# Default when unset: "http://localhost:3000/api/v1"
VITE_API_URL=/api/v1

# ---- Asset base (OPTIONAL) ----
# Origin serving /uploads, which sits outside the /api/v1 prefix.
# When unset it is derived from VITE_API_URL by stripping the version
# suffix, which is correct for local dev. Set explicitly only if uploads
# are served from a different host (e.g. a CDN).
# VITE_ASSET_URL=http://localhost:3000

# ---- Dev proxy target (OPTIONAL - build-time only) ----
# Read in vite.config.ts via loadEnv; targets the /api and /uploads proxies.
# Not exposed to client code. Default when unset: "http://localhost:3000"
VITE_API_PROXY_TARGET=http://localhost:3000
